<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stock Chart</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>Stock Chart</h1>

    <input
      type="text"
      id="stockSearchInput"
      placeholder="Search company or ticker..."
      autocomplete="off"
    >

    <h2 id="chartTitle" hidden></h2>

    <div id="chartRanges" hidden>
      <button type="button" data-range="7D">7D</button>
      <button type="button" data-range="1M">1M</button>
      <button type="button" data-range="3M">3M</button>
      <button type="button" data-range="6M">6M</button>
      <button type="button" data-range="1Y">1Y</button>
    </div>

    <div class="chart-container">
      <canvas id="stockChart"></canvas>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
  <script src="/js/stocks.js" defer></script>
</body>
</html>